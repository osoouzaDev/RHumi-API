NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Cole a Service URI do Aiven depois de revelar a senha.
# O código remove sslmode=require da URI para preservar a validação pelo CA.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_PATH=./certs/aiven-ca.pem
DATABASE_POOL_MAX=10

# UUID de uma empresa já cadastrada em public.empresa.
# Obrigatório ao criar registros em public.usuario (id_empresa NOT NULL).
DEFAULT_EMPRESA_ID=
