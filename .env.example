NODE_ENV=development
PORT=3333
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=debug
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Cole a Service URI do Aiven depois de revelar a senha.
# O código remove sslmode=require da URI para preservar a validação pelo CA.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_PATH=./certs/aiven-ca.pem
DATABASE_POOL_MAX=10

# UUID de uma empresa já cadastrada em public.empresa.
# Obrigatório ao criar registros em public.usuario (id_empresa NOT NULL).
DEFAULT_EMPRESA_ID=

# Armazenamento persistente local usado apenas para PDFs legados.
TRAINING_PDF_DIR=

# Integração OAuth com Google Drive.
GOOGLE_DRIVE_TRAINING_FOLDER_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3001/oauth2/callback
